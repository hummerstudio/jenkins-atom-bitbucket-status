{
  "atomCode": "bitbucket-status",
  "name": "Bitbucket build status",
  "version": "1.1.0",
  "description": "Posts the build state to a Bitbucket Server / Data Center commit, reads it back, and can act on the pull request (approve / withdraw / decline / comment) with a read-back.",
  "execution": {
    "packagePath": "bitbucket-status.jar",
    "language": "java",
    "target": "$atom_java_path -cp bitbucket-status.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "serverUrl": {
      "label": "Bitbucket 地址",
      "type": "vuex-input",
      "default": ""
    },
    "sha": {
      "label": "提交 sha（留空取 GIT_COMMIT）",
      "type": "vuex-input",
      "default": ""
    },
    "state": {
      "label": "状态（留空按 BUILD_STATUS 推断）",
      "type": "vuex-input",
      "default": ""
    },
    "key": {
      "label": "构建标识 key（留空用 JOB_NAME）",
      "type": "vuex-input",
      "default": ""
    },
    "name": {
      "label": "显示名（留空用 JOB_NAME #BUILD_NUMBER）",
      "type": "vuex-input",
      "default": ""
    },
    "description": {
      "label": "描述（留空自动生成）",
      "type": "vuex-input",
      "default": ""
    },
    "buildUrl": {
      "label": "构建链接（留空取 BUILD_URL）",
      "type": "vuex-input",
      "default": ""
    },
    "username": {
      "label": "用户名（Basic 认证时用）",
      "type": "vuex-input",
      "default": ""
    },
    "password": {
      "label": "个人访问令牌或密码（凭据 id，Secret text）",
      "type": "vuex-input",
      "default": "",
      "isSensitive": true
    },
    "token": {
      "label": "HTTP 访问令牌（凭据 id，Secret text；留空则用用户名+密码）",
      "type": "vuex-input",
      "default": "",
      "isSensitive": true
    },
    "considerUnstableAsSuccess": {
      "label": "把 UNSTABLE 报成 SUCCESSFUL",
      "type": "boolean",
      "default": "false"
    },
    "notifyAborted": {
      "label": "中止/未构建的构建也上报（已 FAILED）",
      "type": "boolean",
      "default": "false"
    },
    "includeBuildNumberInKey": {
      "label": "key 里带上构建号",
      "type": "boolean",
      "default": "false"
    },
    "verifyAfterWrite": {
      "label": "写完回读校验",
      "type": "boolean",
      "default": "true"
    },
    "pullRequestUrl": {
      "label": "Pull request 页面地址（可选）",
      "type": "vuex-input",
      "default": ""
    },
    "projectKey": {
      "label": "项目 key（PR 动作时要）",
      "type": "vuex-input",
      "default": ""
    },
    "repoSlug": {
      "label": "仓库 slug（PR 动作时要）",
      "type": "vuex-input",
      "default": ""
    },
    "pullRequestId": {
      "label": "PR 编号（留空取 CHANGE_ID）",
      "type": "vuex-input",
      "default": ""
    },
    "prAction": {
      "label": "PR 动作：none / approve（绿批红撤）/ decline（红关）",
      "type": "vuex-input",
      "default": "none"
    },
    "comment": {
      "label": "PR 评论（支持 ${VAR}；留空不发）",
      "type": "vuex-input",
      "default": ""
    }
  },
  "output": {
    "status": {
      "type": "string",
      "description": "HTTP 状态码"
    },
    "state": {
      "type": "string",
      "description": "上报的状态（SUCCESSFUL / FAILED / INPROGRESS / SKIPPED）"
    },
    "key": {
      "type": "string",
      "description": "实际发送的 key"
    },
    "apiUrl": {
      "type": "string",
      "description": "实际调用的地址"
    },
    "verified": {
      "type": "string",
      "description": "回读到的状态"
    },
    "prAction": {
      "type": "string",
      "description": "实际执行的 PR 动作（none / approve / withdraw-approve / decline）"
    },
    "prVerified": {
      "type": "string",
      "description": "回读到的 PR 状态（approved / withdrawn / declined / not-checked）"
    },
    "commentId": {
      "type": "string",
      "description": "回读到的评论 id"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    },
    "secrets": {
      "token": "",
      "password": ""
    }
  }
}
